+    case MAPSEC_PETALBURG_CITY:  return TYPE_NORMAL;
+    case MAPSEC_FORTREE_CITY:    return TYPE_FLYING;
+    case MAPSEC_MOSSDEEP_CITY:   return TYPE_PSYCHIC;
+    case MAPSEC_SOOTOPOLIS_CITY: return TYPE_WATER;
+    }
+    return TYPE_MYSTERY;
