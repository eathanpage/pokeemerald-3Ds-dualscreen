+static struct ObjectEvent *GetPlayerObject(void)
+{
+    struct ObjectEvent *player;
+    if (gPlayerAvatar.objectEventId >= OBJECT_EVENTS_COUNT)
+        return NULL;
+    player = &gObjectEvents[gPlayerAvatar.objectEventId];
+    return (player->active && player->isPlayer) ? player : NULL;
+}
+
+// The Pokemon that should be out now, or NULL.
+static struct Pokemon *GetVisibleFollowerMon(void)
+{
+    struct ObjectEvent *player = GetPlayerObject();
+    struct Pokemon *mon;
+
+    if (!PlatformFollowingPokemonEnabled() || !player || player->invisible)
+        return NULL;
+    // Back in its Ball on a Bike or in the water, as in HGSS.
+    if (gPlayerAvatar.flags & (PLAYER_AVATAR_FLAG_SURFING | PLAYER_AVATAR_FLAG_UNDERWATER
+                             | PLAYER_AVATAR_FLAG_MACH_BIKE | PLAYER_AVATAR_FLAG_ACRO_BIKE))
+        return NULL;
+    mon = GetFollowerMon();
+    if (!mon || !IsAllowedHere(GetMonData(mon, MON_DATA_SPECIES)))
+        return NULL;
+    return mon;
+}
