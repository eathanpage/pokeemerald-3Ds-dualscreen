+
+// Mixes the follower's colours with white (0-16): the flash as it comes out
+// of or goes into its Ball.
+static void SetFollowerWhiteness(int amount)
+{
+    u16 colors[16];
+    int i, c;
+
+    for (i = 0; i < 16; i++)
+    {
+        u16 color = 0;
+        for (c = 0; c < 3; c++)
+        {
+            int v = (sPalette[i] >> (c * 5)) & 31;
+            v += (31 - v) * amount / 16;
+            color |= v << (c * 5);
+        }
+        colors[i] = color;
+    }
+    PlatformSetExtObjPalette(EXT_PALETTE_FOLLOWER, sFrameImages, colors);
+}
+
+// A Ball on the follower's tile, in front of it. MAX_SPRITES if there's no
+// room for it (the Pokemon still flashes in or out).
+static u8 CreateBallSprite(struct ObjectEvent *obj, struct Pokemon *mon, u8 mode)
+{
+    struct Sprite *monSprite = &gSprites[obj->spriteId];
+    u8 ballId = ItemIdToBallId(GetMonData(mon, MON_DATA_POKEBALL));
+    u16 tileTag, paletteTag;
+    u8 paletteIndex, spriteId;
+
+    if (ballId >= POKEBALL_COUNT)
+        ballId = BALL_POKE;
+    tileTag = gBallSpriteSheets[ballId].tag;
+    paletteTag = gBallSpritePalettes[ballId].tag;
+    if (GetSpriteTileStartByTag(tileTag) == 0xFFFF)
+        LoadCompressedSpriteSheet(&gBallSpriteSheets[ballId]);
+    if (IndexOfSpritePaletteTag(paletteTag) == 0xFF)
+    {
+        LoadCompressedSpritePalette(&gBallSpritePalettes[ballId]);
+        paletteIndex = IndexOfSpritePaletteTag(paletteTag);
+        if (paletteIndex == 0xFF)
+        {
+            FreeSpriteTilesByTag(tileTag);
+            return MAX_SPRITES;
+        }
+        UpdateSpritePaletteWithWeather(paletteIndex);
+    }
+
+    sBallTemplate.tileTag = tileTag;
+    sBallTemplate.paletteTag = paletteTag;
+    sBallTemplate.oam = &sOam_Ball;
+    sBallTemplate.anims = sAnims_Ball;
+    sBallTemplate.images = NULL;
+    sBallTemplate.affineAnims = gDummySpriteAffineAnimTable;
+    sBallTemplate.callback = SpriteCB_Ball;
+    spriteId = CreateSprite(&sBallTemplate, monSprite->x, monSprite->y + sGraphicsInfo.height / 2 - 8, 0);
+    if (spriteId == MAX_SPRITES)
+    {
+        FreeSpriteTilesByTag(tileTag);
+        FreeSpritePaletteByTag(paletteTag);
+        return MAX_SPRITES;
+    }
+    gSprites[spriteId].coordOffsetEnabled = TRUE;
+    gSprites[spriteId].oam.priority = monSprite->oam.priority;
+    gSprites[spriteId].data[0] = ballId;
+    gSprites[spriteId].data[1] = obj->previousElevation;
+    gSprites[spriteId].data[2] = mode == BALL_RELEASE ? 2 : 0;
+    SpriteCB_Ball(&gSprites[spriteId]);
+
+    return spriteId;
+}
+
+static void DestroyBallSprite(u8 spriteId)
+{
+    if (spriteId < MAX_SPRITES && gSprites[spriteId].inUse)
+    {
+        u8 ballId = gSprites[spriteId].data[0];
+        DestroySprite(&gSprites[spriteId]);
+        FreeSpriteTilesByTag(gBallSpriteSheets[ballId].tag);
+        FreeSpritePaletteByTag(gBallSpritePalettes[ballId].tag);
+    }
+}
+
+#define tMode   data[0]
+#define tTimer  data[1]
+#define tBall   data[2]
+#define tObjId  data[3]
+
+static void FinishBallTask(u8 taskId)
+{
+    struct Task *task = &gTasks[taskId];
+    struct ObjectEvent *obj = &gObjectEvents[task->tObjId];
+
+    DestroyBallSprite(task->tBall);
+    if (Follower_IsFollower(obj))
+    {
+        if (task->tMode == BALL_RECALL)
+        {
+            RemoveFollower(obj);
+        }
+        else
+        {
+            obj->invisible = FALSE;
+            gSprites[obj->spriteId].invisible = FALSE;
+        }
+    }
+    SetFollowerWhiteness(0);
+    DestroyTask(taskId);
+}
+
+static void Task_FollowerBall(u8 taskId)
+{
+    struct Task *task = &gTasks[taskId];
+    struct ObjectEvent *obj = &gObjectEvents[task->tObjId];
+    struct Sprite *ball = task->tBall < MAX_SPRITES ? &gSprites[task->tBall] : NULL;
+    bool8 haveMon = Follower_IsFollower(obj);
+    int t = task->tTimer++;
+
+    if (task->tMode == BALL_RELEASE)
+    {
+        // Half a step after the player leaves the spot, the Ball appears
+        // there, hops and opens, and out comes the Pokemon in a white flash.
+        if (ball)
+        {
+            ball->invisible = t < 8;
+            ball->y2 = (t >= 8 && t < 14) ? -((t - 8) * (14 - t)) / 3 : 0;
+        }
+        if (t == 14)
+        {
+            if (ball)
+                StartSpriteAnim(ball, BALL_ANIM_OPEN);
+            PlaySE(SE_BALL_OPEN);
+        }
+        if (t >= 16 && haveMon)
+        {
+            obj->invisible = FALSE;
+            SetFollowerWhiteness(t < 28 ? (28 - t) * 16 / 12 : 0);
+        }
+        if (t == 22)
+        {
+            DestroyBallSprite(task->tBall);
+            task->tBall = MAX_SPRITES;
+        }
+        if (t >= 28)
+            FinishBallTask(taskId);
+    }
+    else
+    {
+        // It goes white and into the open Ball, which closes and lifts away.
+        if (t == 0)
+            PlaySE(SE_BALL_TRADE);
+        if (t <= 8 && haveMon)
+            SetFollowerWhiteness(t * 2);
+        if (t == 8)
+        {
+            if (haveMon)
+                RemoveFollower(obj);
+            if (ball)
+                StartSpriteAnim(ball, BALL_ANIM_CLOSE);
+        }
+        if (ball && t > 20)
+            ball->y2 = -(t - 20) * 2;
+        if (t >= 26)
+            FinishBallTask(taskId);
+    }
+}
+
+static void StartBallTask(struct ObjectEvent *obj, u8 mode)
+{
+    struct Pokemon *mon = GetFollowerMon();
+    u8 taskId = FindTaskIdByFunc(Task_FollowerBall);
+
+    if (taskId != TASK_NONE)
+        FinishBallTask(taskId); // one at a time
+    if (!Follower_IsFollower(obj))
+        return;
+    taskId = CreateTask(Task_FollowerBall, 81);
+    gTasks[taskId].tMode = mode;
+    gTasks[taskId].tObjId = obj - gObjectEvents;
+    gTasks[taskId].tBall = mon ? CreateBallSprite(obj, mon, mode) : MAX_SPRITES;
+
+    if (mode == BALL_RELEASE)
+    {
+        obj->invisible = TRUE;
+        gSprites[obj->spriteId].invisible = TRUE;
+        if (gTasks[taskId].tBall < MAX_SPRITES)
+        {
+            StartSpriteAnim(&gSprites[gTasks[taskId].tBall], BALL_ANIM_CLOSED);
+            gSprites[gTasks[taskId].tBall].invisible = TRUE;
+        }
+
+    }
+    else if (gTasks[taskId].tBall < MAX_SPRITES)
+    {
+        StartSpriteAnim(&gSprites[gTasks[taskId].tBall], BALL_ANIM_OPEN);
+    }
+}
+
+#undef tMode
+#undef tTimer
+#undef tBall
+#undef tObjId
+
+// Comes out of its Ball at (x, y).
+static struct ObjectEvent *ReleaseFollower(s16 x, s16 y, u8 direction)
+{
+    struct ObjectEvent *obj = SpawnFollower(x, y, direction);
+    if (obj)
+        StartBallTask(obj, BALL_RELEASE);
+    return obj;
+}
+
+// The player is about to warp: going into a building, the Pokemon goes back
+// into its Ball as the door opens, and stays there until the next map.
+void Follower_OnWarpStart(void)
+{
+    struct ObjectEvent *obj;
+
+    if (IsMapTypeIndoors(gMapHeader.mapType) || !IsMapTypeIndoors(GetWarpDestinationMapType()))
+        return;
+    sFollower.recalled = TRUE;
+    ClearTrail();
+    obj = GetFollowerObject();
+    if (obj && !sFollower.interacting)
+        StartBallTask(obj, BALL_RECALL);
+}
+
+// Someone (the player included) stepping onto the follower's tile while a
+// script has the player held, in a cutscene or as a trainer walks up: the
+// Pokemon goes back into its Ball rather than being walked through, and
+// comes out again once the script is over and the player can move.
+// Called from ShiftObjectEventCoords as `mover` starts a step to (x, y).
+void Follower_OnObjectStep(const struct ObjectEvent *mover, s16 x, s16 y)
+{
+    struct ObjectEvent *obj;
+
+    if (sFollower.inCutscene || sFollower.interacting || Follower_IsFollower(mover))
+        return;
+    if (!ScriptContext_IsEnabled() && !ArePlayerFieldControlsLocked())
+        return;
+    obj = GetFollowerObject();
+    if (!obj || obj->invisible)
+        return;
+    if ((x == obj->currentCoords.x && y == obj->currentCoords.y)
+     || (IsMoving(obj) && x == obj->previousCoords.x && y == obj->previousCoords.y))
+    {
+        sFollower.inCutscene = TRUE;
+        ClearTrail();
+        StartBallTask(obj, BALL_RECALL);
+    }
+}
+
+// Somewhere the follower can stand: walkable, at the player's height and
+// free of other objects.
+static bool8 CanStandAt(struct ObjectEvent *player, s16 x, s16 y)
+{
+    u8 behavior = MapGridGetMetatileBehaviorAt(x, y);
+    u8 elevation = MapGridGetElevationAt(x, y);
+
+    if (MapGridGetCollisionAt(x, y) || GetObjectEventIdByXY(x, y) != OBJECT_EVENTS_COUNT)
+        return FALSE;
+    if (elevation != 0 && elevation != 15 && player->currentElevation != 0 && player->currentElevation != 15
+     && elevation != player->currentElevation)
+        return FALSE;
+    if (MetatileBehavior_IsSurfableWaterOrUnderwater(behavior) || MetatileBehavior_IsWaterfall(behavior))
+        return FALSE;
+    return TRUE;
+}
+
+// After a map loads (or the Pokemon comes back out) it appears behind the
+// player if there's room; otherwise it comes out on the player's next step.
+static void TrySpawnBehindPlayer(void)
+{
+    struct ObjectEvent *player = GetPlayerObject();
+    s16 x, y;
+
+    if (!player || IsMoving(player) || ArePlayerFieldControlsLocked() || gPaletteFade.active)
+        return;
+    x = player->currentCoords.x;
+    y = player->currentCoords.y;
+    MoveCoords(GetOppositeDirection(player->facingDirection), &x, &y);
+    if (!sFollower.waitForStep && CanStandAt(player, x, y))
+        ReleaseFollower(x, y, player->facingDirection);
+}
+
+// The walk that takes the follower one tile in `direction`, keeping up with
+// a player who moved the way `kind` says (faster if it's behind).
+static u8 GetWalkAction(u8 kind, u8 direction, bool8 hurry)
+{
+    switch (kind)
+    {
+    case FOLLOWER_STEP_SLOW:
+        return hurry ? GetWalkNormalMovementAction(direction) : GetWalkSlowMovementAction(direction);
+    case FOLLOWER_STEP_NORMAL:
+    case FOLLOWER_STEP_JUMP:
+    case FOLLOWER_STEP_JUMP2:
+    default:
+        return hurry ? GetWalkFastMovementAction(direction) : GetWalkNormalMovementAction(direction);
+    case FOLLOWER_STEP_FAST:
+        return hurry ? GetWalkFasterMovementAction(direction) : GetWalkFastMovementAction(direction);
+    case FOLLOWER_STEP_FAST_2:
+        return hurry ? GetWalkFasterMovementAction(direction) : GetRideWaterCurrentMovementAction(direction);
+    case FOLLOWER_STEP_FASTER:
+        return hurry ? GetSlideMovementAction(direction) : GetWalkFasterMovementAction(direction);
+    case FOLLOWER_STEP_FASTEST:
+        return GetSlideMovementAction(direction);
+    }
+}
+
+// Sends the follower to the next tile of the player's trail if it's free.
+// Returns TRUE if it started moving.
+static bool8 FollowTrail(struct ObjectEvent *obj)
+{
+    while (sFollower.trailCount > 0 && !IsMoving(obj))
+    {
+        struct TrailStep step = sFollower.trail[0];
+        s16 dx = step.x - obj->currentCoords.x;
+        s16 dy = step.y - obj->currentCoords.y;
+        u8 direction, action;
+
+        memmove(&sFollower.trail[0], &sFollower.trail[1], (sFollower.trailCount - 1) * sizeof(sFollower.trail[0]));
+        sFollower.trailCount--;
+
+        if (dx == 0 && dy == 0)
+            continue;
+        if (dy > 0)
+            direction = DIR_SOUTH;
+        else if (dy < 0)
+            direction = DIR_NORTH;
+        else if (dx < 0)
+            direction = DIR_WEST;
+        else
+            direction = DIR_EAST;
+
+        if (abs(dx) + abs(dy) == 1)
+        {
+            action = GetWalkAction(step.kind, direction, sFollower.trailCount > 0);
+        }
+        else if ((abs(dx) == 2 && dy == 0) || (dx == 0 && abs(dy) == 2))
+        {
+            action = GetJump2MovementAction(direction); // over the ledge the player jumped
+        }
+        else
+        {
+            // Lost track (the player was moved some other way): catch up.
+            MoveObjectEventToMapCoords(obj, step.x, step.y);
+            continue;
+        }
+        ObjectEventClearHeldMovementIfFinished(obj);
+        if (ObjectEventSetHeldMovement(obj, action))
+            return FALSE;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+// The player started a step from (fromX, fromY), `kind` saying how (one of
+// FOLLOWER_STEP_*). Called from the player's sprite callback, so the
+// follower can start its step in the same frame.
+void Follower_OnPlayerStep(s16 fromX, s16 fromY, u8 kind)
+{
+    struct ObjectEvent *obj = GetFollowerObject();
+    struct ObjectEvent *player = GetPlayerObject();
+
+    if (!player || sFollower.interacting || sFollower.recalled || sFollower.inCutscene)
+        return;
+    if (!obj)
+    {
+        struct Pokemon *mon = GetVisibleFollowerMon();
+        // Out of its Ball where the player was standing. After leaving a
+        // building, not on the step out of the door but the one after.
+        if (mon && !(sFollower.waitForStep && ArePlayerFieldControlsLocked()))
+        {
+            UpdateGraphics(mon);
+            if (ReleaseFollower(fromX, fromY, player->movementDirection))
+                sFollower.waitForStep = FALSE;
+        }
+        return;
+    }
+
+    if (sFollower.trailCount == TRAIL_LENGTH)
+    {
+        memmove(&sFollower.trail[0], &sFollower.trail[1], (TRAIL_LENGTH - 1) * sizeof(sFollower.trail[0]));
+        sFollower.trailCount--;
+    }
+    sFollower.trail[sFollower.trailCount].x = fromX;
+    sFollower.trail[sFollower.trailCount].y = fromY;
+    sFollower.trail[sFollower.trailCount].kind = kind;
+    sFollower.trailCount++;
+
+    // Sprites are updated in order; if the follower's has been already, give
+    // it this frame's update now so it keeps in step with the player.
+    if (FollowTrail(obj) && obj->spriteId < player->spriteId)
+        gSprites[obj->spriteId].callback(&gSprites[obj->spriteId]);
+}
+
+void Follower_Update(void)
+{
+    struct ObjectEvent *obj = GetFollowerObject();
+    struct ObjectEvent *player = GetPlayerObject();
+    struct Pokemon *mon;
+    struct Sprite *sprite;
+    u16 map = CurrentMapId();
+#ifdef PLATFORM_3DS
+    UpdateExtObjPalettes();
+#endif
+
+    if (!player)
+        return;
+
+    // A new map. Coming out of a building, it stays in its Ball until the
+    // player's first step outside (the walk out of the door doesn't count).
+    if (!sFollower.mapKnown || map != sFollower.lastMap)
+    {
+        if (sFollower.mapKnown)
+            sFollower.waitForStep = IsMapTypeIndoors(GetLastUsedWarpMapType()) && !IsMapTypeIndoors(gMapHeader.mapType);
+        sFollower.mapKnown = TRUE;
+        sFollower.lastMap = map;
+        sFollower.recalled = FALSE;
+    }
+    if (sFollower.inCutscene && !ScriptContext_IsEnabled() && !ArePlayerFieldControlsLocked())
+        sFollower.inCutscene = FALSE;
+    if (sFollower.interacting || sFollower.recalled || sFollower.inCutscene)
+        return;
+
+    mon = GetVisibleFollowerMon();
+    if (!mon)
+    {
+        if (obj)
+            RemoveFollower(obj);
+        ClearTrail();
+        return;
+    }
+    if (UpdateGraphics(mon) && obj)
+    {
+        // A different Pokemon (or form) leads now.
+        s16 x = obj->currentCoords.x, y = obj->currentCoords.y;
+        u8 direction = obj->facingDirection;
+        RemoveFollower(obj);
+        obj = ReleaseFollower(x, y, direction);
+    }
+    if (!obj)
+    {
+        ClearTrail();
+        TrySpawnBehindPlayer();
+        return;
+    }
+
+    // Moved off on its own (warped within the map, put on the player's tile
+    // by a script...): it comes back out on the next step.
+    if (!IsMoving(obj) && !IsMoving(player))
+    {
+        s32 distance = abs(obj->currentCoords.x - player->currentCoords.x)
+                     + abs(obj->currentCoords.y - player->currentCoords.y);
+        if (distance == 0 || distance > sFollower.trailCount + 2)
+        {
+            RemoveFollower(obj);
+            return;
+        }
+    }
+
+    FollowTrail(obj);
+
+    // HGSS's walking Pokemon keep stepping while they stand still.
+    sprite = &gSprites[obj->spriteId];
+    if (!IsMoving(obj))
+    {
+        u8 anim = GetFaceDirectionAnimNum(obj->facingDirection);
+        if (sprite->animNum != anim)
+            StartSpriteAnim(sprite, anim);
+        sprite->animPaused = FALSE;
+    }
+}
