+// Looks for a tile within `distance` in a straight line from the follower;
+// remembers which way it is.
+static bool8 IsNear(struct ObjectEvent *obj, bool8 (*isBehavior)(u8), u8 behavior, int distance)
+{
+    static const s8 dirs[4][3] = {{DIR_SOUTH, 0, 1}, {DIR_NORTH, 0, -1}, {DIR_WEST, -1, 0}, {DIR_EAST, 1, 0}};
+    int d, i;
+    for (d = 0; d < 4; d++)
+    {
+        for (i = 1; i <= distance; i++)
+        {
+            u8 mb = MapGridGetMetatileBehaviorAt(obj->currentCoords.x + dirs[d][1] * i, obj->currentCoords.y + dirs[d][2] * i);
+            if (isBehavior ? isBehavior(mb) : mb == behavior)
+            {
+                sFollower.lookDirection = dirs[d][0];
+                return TRUE;
+            }
+        }
+    }
+    return FALSE;
+}
+
+// How well a Pokemon of these types takes hits of attackType (10 = normally).
+static int TypeEffectiveness(u16 species, u8 attackType)
+{
+    int i, result = 10;
+    for (i = 0; TYPE_EFFECT_ATK_TYPE(i) != TYPE_ENDTABLE; i += 3)
+    {
+        if (TYPE_EFFECT_ATK_TYPE(i) == TYPE_FORESIGHT)
+            break;
+        if (TYPE_EFFECT_ATK_TYPE(i) != attackType)
+            continue;
+        if (TYPE_EFFECT_DEF_TYPE(i) == gSpeciesInfo[species].types[0])
+            result = result * TYPE_EFFECT_MULTIPLIER(i) / 10;
+        if (gSpeciesInfo[species].types[1] != gSpeciesInfo[species].types[0]
+         && TYPE_EFFECT_DEF_TYPE(i) == gSpeciesInfo[species].types[1])
+            result = result * TYPE_EFFECT_MULTIPLIER(i) / 10;
+    }
+    return result;
+}
