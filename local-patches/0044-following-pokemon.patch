+static struct ObjectEvent *SpawnFollower(s16 x, s16 y, u8 direction)
+{
+    struct ObjectEvent *player = GetPlayerObject();
+    struct ObjectEvent *obj;
+    u8 id;
+
+    // Leave a slot for objects scripts add (the follower gives its own up
+    // to any object that needs one, see Follower_YieldObjectSlot).
+    if (!player || !sFollower.haveGraphics || CountFreeObjectSlots() < 2)
+        return NULL;
+    id = SpawnSpecialObjectEventParameterized(OBJ_EVENT_GFX_FOLLOWER, MOVEMENT_TYPE_NONE, LOCALID_FOLLOWER,
+                                              x, y, player->currentElevation);
+    if (id >= OBJECT_EVENTS_COUNT)
+        return NULL;
+    obj = &gObjectEvents[id];
+    ObjectEventTurn(obj, direction);
+    ClearTrail();
+    return obj;
+}
