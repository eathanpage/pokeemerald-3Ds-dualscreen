+#define tState  data[0]
+#define tMotion data[1]
+#define tEmote  data[2]
+#define tCry    data[3]
+#define tTimer  data[4]
+
+// Cry, emote and animation, then the script carries on with the message.
+static void Task_FollowerReact(u8 taskId)
+{
+    struct Task *task = &gTasks[taskId];
+    struct ObjectEvent *obj = GetFollowerObject();
+
+    if (!obj)
+    {
+        sFollower.interacting = FALSE;
+        ScriptContext_Enable();
+        DestroyTask(taskId);
+        return;
+    }
+
+    switch (task->tState)
+    {
+    case 0:
+        ShowEmote(obj, task->tEmote);
+        if (task->tCry)
+            PlayCry_Normal(sFollower.species, 0);
+        if (task->tMotion != FOLLOWER_MOTION_NONE && task->tMotion != FOLLOWER_MOTION_SHIVER)
+        {
+            BuildMotion(task->tMotion, obj->facingDirection);
+            ScriptMovement_StartObjectMovementScript(LOCALID_FOLLOWER, obj->mapNum, obj->mapGroup, sMotionScript);
+        }
+        task->tState++;
+        break;
+    case 1:
+        task->tTimer++;
+        if (task->tMotion == FOLLOWER_MOTION_SHIVER)
+            gSprites[obj->spriteId].x2 = (task->tTimer < 40) ? ((task->tTimer >> 1) & 1 ? 1 : -1) : 0;
+        if (task->tMotion != FOLLOWER_MOTION_NONE && task->tMotion != FOLLOWER_MOTION_SHIVER
+         && !ScriptMovement_IsObjectMovementFinished(LOCALID_FOLLOWER, obj->mapNum, obj->mapGroup))
+            break;
+        if (task->tTimer < 40)
+            break;
+        gSprites[obj->spriteId].x2 = 0;
+        sFollower.interacting = FALSE;
+        ScriptContext_Enable();
+        DestroyTask(taskId);
+        break;
+    }
+}
+
+static void StartReaction(u8 emote, u8 motion, bool8 cry)
+{
+    u8 taskId = CreateTask(Task_FollowerReact, 80);
+    gTasks[taskId].tEmote = emote;
+    gTasks[taskId].tMotion = motion;
+    gTasks[taskId].tCry = cry;
+    sFollower.interacting = TRUE;
+}
