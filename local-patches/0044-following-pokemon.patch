+// ---------------------------------------------------------------------------
+// Talking to it: the little animations
+
+static u8 sMotionScript[24];
+
+static void BuildMotion(u8 motion, u8 facing)
+{
+    u8 away = GetOppositeDirection(facing);
+    u8 *s = sMotionScript;
+    int i;
+
+    switch (motion)
+    {
+    case FOLLOWER_MOTION_HOP:
+        *s++ = GetJumpInPlaceMovementAction(facing);
+        *s++ = MOVEMENT_ACTION_DELAY_4;
+        *s++ = GetJumpInPlaceMovementAction(facing);
+        break;
+    case FOLLOWER_MOTION_DANCE:
+        for (i = 0; i < 2; i++)
+        {
+            *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_UP;
+            *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_LEFT;
+            *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_DOWN;
+            *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_RIGHT;
+        }
+        *s++ = GetJumpInPlaceMovementAction(facing);
+        *s++ = MOVEMENT_ACTION_FACE_PLAYER;
+        break;
+    case FOLLOWER_MOTION_SPIN:
+        for (i = 0; i < 2; i++)
+        {
+            *s++ = MOVEMENT_ACTION_FACE_DOWN;
+            *s++ = MOVEMENT_ACTION_DELAY_4;
+            *s++ = MOVEMENT_ACTION_FACE_LEFT;
+            *s++ = MOVEMENT_ACTION_DELAY_4;
+            *s++ = MOVEMENT_ACTION_FACE_UP;
+            *s++ = MOVEMENT_ACTION_DELAY_4;
+            *s++ = MOVEMENT_ACTION_FACE_RIGHT;
+            *s++ = MOVEMENT_ACTION_DELAY_4;
+        }
+        *s++ = MOVEMENT_ACTION_FACE_PLAYER;
+        break;
+    case FOLLOWER_MOTION_LOOK_AROUND:
+        *s++ = MOVEMENT_ACTION_FACE_AWAY_PLAYER;
+        *s++ = MOVEMENT_ACTION_DELAY_16;
+        *s++ = (facing == DIR_NORTH || facing == DIR_SOUTH) ? MOVEMENT_ACTION_FACE_LEFT : MOVEMENT_ACTION_FACE_UP;
+        *s++ = MOVEMENT_ACTION_DELAY_16;
+        *s++ = (facing == DIR_NORTH || facing == DIR_SOUTH) ? MOVEMENT_ACTION_FACE_RIGHT : MOVEMENT_ACTION_FACE_DOWN;
+        *s++ = MOVEMENT_ACTION_DELAY_16;
+        *s++ = MOVEMENT_ACTION_FACE_PLAYER;
+        break;
+    case FOLLOWER_MOTION_LOOK_AWAY:
+        *s++ = MOVEMENT_ACTION_FACE_AWAY_PLAYER;
+        *s++ = MOVEMENT_ACTION_DELAY_16;
+        break;
+    case FOLLOWER_MOTION_STARTLED:
+        *s++ = MOVEMENT_ACTION_FACE_AWAY_PLAYER;
+        *s++ = MOVEMENT_ACTION_LOCK_FACING_DIRECTION;
+        *s++ = GetJumpInPlaceMovementAction(away);
+        *s++ = MOVEMENT_ACTION_UNLOCK_FACING_DIRECTION;
+        *s++ = MOVEMENT_ACTION_DELAY_8;
+        *s++ = MOVEMENT_ACTION_FACE_PLAYER;
+        break;
+    case FOLLOWER_MOTION_POKE:
+        *s++ = MOVEMENT_ACTION_LOCK_FACING_DIRECTION;
+        for (i = 0; i < 2; i++)
+        {
+            *s++ = GetWalkFasterMovementAction(facing);
+            *s++ = MOVEMENT_ACTION_DELAY_4;
+            *s++ = GetWalkFasterMovementAction(away);
+            *s++ = MOVEMENT_ACTION_DELAY_4;
+        }
+        *s++ = MOVEMENT_ACTION_UNLOCK_FACING_DIRECTION;
+        break;
+    case FOLLOWER_MOTION_CLOSER:
+        *s++ = MOVEMENT_ACTION_LOCK_FACING_DIRECTION;
+        *s++ = GetWalkFastMovementAction(facing);
+        *s++ = MOVEMENT_ACTION_DELAY_16;
+        *s++ = MOVEMENT_ACTION_DELAY_8;
+        *s++ = GetWalkFastMovementAction(away);
+        *s++ = MOVEMENT_ACTION_UNLOCK_FACING_DIRECTION;
+        break;
+    case FOLLOWER_MOTION_POKE_GROUND:
+        *s++ = MOVEMENT_ACTION_FACE_DOWN;
+        for (i = 0; i < 3; i++)
+            *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_DOWN;
+        *s++ = MOVEMENT_ACTION_FACE_PLAYER;
+        break;
+    case FOLLOWER_MOTION_DIZZY:
+        *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_NORMAL_LEFT;
+        *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_RIGHT;
+        *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_NORMAL_UP;
+        *s++ = MOVEMENT_ACTION_WALK_IN_PLACE_FAST_DOWN;
+        *s++ = MOVEMENT_ACTION_DELAY_4;
+        *s++ = MOVEMENT_ACTION_FACE_PLAYER;
+        break;
+    case FOLLOWER_MOTION_LOOK_AT:
+        *s++ = GetFaceDirectionMovementAction(sFollower.lookDirection);
+        *s++ = MOVEMENT_ACTION_DELAY_16;
+        break;
+    }
+    *s = MOVEMENT_ACTION_STEP_END;
