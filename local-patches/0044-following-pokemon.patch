+                   SPECIES_HUNTAIL, SPECIES_GOREBYSS))
+        ADD(712, NEUTRAL, NONE);
+    if (SPECIES_IN(species, SPECIES_TYRANITAR, SPECIES_SALAMENCE, SPECIES_ZANGOOSE, SPECIES_SCYTHER,
+                   SPECIES_URSARING, SPECIES_SNEASEL, SPECIES_AERODACTYL, SPECIES_CHARIZARD, SPECIES_AGGRON))
+        ADD(711, ANGRY, NONE);
+    if (SPECIES_IN(species, SPECIES_RAIKOU, SPECIES_ENTEI, SPECIES_SUICUNE, SPECIES_LUGIA, SPECIES_HO_OH,
