+// How it feels: weights like those of pokeemerald-expansion's recreation,
+// shifted by friendship and by the HGSS mood.
+static u8 ChooseEmotion(struct Pokemon *mon)
+{
+    u8 weights[FOLLOWER_EMOTE_COUNT] = {
+        [FOLLOWER_EMOTE_HAPPY] = 10,
+        [FOLLOWER_EMOTE_NEUTRAL] = 15,
+        [FOLLOWER_EMOTE_SAD] = 5,
+        [FOLLOWER_EMOTE_UPSET] = 15,
+        [FOLLOWER_EMOTE_ANGRY] = 15,
+        [FOLLOWER_EMOTE_PENSIVE] = 15,
+        [FOLLOWER_EMOTE_LOVE] = 0,
+        [FOLLOWER_EMOTE_SURPRISE] = 10,
+        [FOLLOWER_EMOTE_CURIOUS] = 10,
+        [FOLLOWER_EMOTE_MUSIC] = 15,
+        [FOLLOWER_EMOTE_POISONED] = 0,
+    };
+    u8 friendship = GetMonData(mon, MON_DATA_FRIENDSHIP);
+    u16 hp = GetMonData(mon, MON_DATA_HP), maxHp = GetMonData(mon, MON_DATA_MAX_HP);
+    u32 total = 0, roll;
+    int i;
+
+    if (GetMonData(mon, MON_DATA_STATUS) & STATUS1_PSN_ANY)
+        return FOLLOWER_EMOTE_POISONED;
+
+    if (friendship > 80)
+    {
+        weights[FOLLOWER_EMOTE_HAPPY] = 20;
+        weights[FOLLOWER_EMOTE_UPSET] = 5;
+        weights[FOLLOWER_EMOTE_ANGRY] = 5;
+        weights[FOLLOWER_EMOTE_LOVE] = 20;
+        weights[FOLLOWER_EMOTE_MUSIC] = 20;
+    }
+    if (friendship > 170)
+    {
+        weights[FOLLOWER_EMOTE_HAPPY] = 30;
+        weights[FOLLOWER_EMOTE_LOVE] = 30;
+    }
+    if (sFollower.mood > 40)
+    {
+        weights[FOLLOWER_EMOTE_HAPPY] += 15;
+        weights[FOLLOWER_EMOTE_LOVE] += 10;
+        weights[FOLLOWER_EMOTE_MUSIC] += 10;
+        weights[FOLLOWER_EMOTE_SAD] = 0;
+        weights[FOLLOWER_EMOTE_UPSET] = 0;
+        weights[FOLLOWER_EMOTE_ANGRY] = 0;
+    }
+    else if (sFollower.mood < -40)
+    {
+        weights[FOLLOWER_EMOTE_SAD] += 25;
+        weights[FOLLOWER_EMOTE_UPSET] += 10;
+        weights[FOLLOWER_EMOTE_ANGRY] += 10;
+        weights[FOLLOWER_EMOTE_HAPPY] = 5;
+        weights[FOLLOWER_EMOTE_LOVE] = 0;
+        weights[FOLLOWER_EMOTE_MUSIC] = 5;
+    }
+    if (maxHp && hp * 5 < maxHp)
+        weights[FOLLOWER_EMOTE_SAD] = 30;
+
+    for (i = 0; i < FOLLOWER_EMOTE_COUNT; i++)
+        total += weights[i];
+    roll = Random() % total;
+    for (i = 0; i < FOLLOWER_EMOTE_COUNT; i++)
+    {
+        if (roll < weights[i])
+            return i;
+        roll -= weights[i];
+    }
+    return FOLLOWER_EMOTE_NEUTRAL;
+}
+
+// Something it found while walking along.
+static u16 ChooseFoundItem(void)
+{
+    static const u16 sCommon[] = {
+        ITEM_POTION, ITEM_ANTIDOTE, ITEM_PARALYZE_HEAL, ITEM_AWAKENING, ITEM_BURN_HEAL, ITEM_ICE_HEAL,
+        ITEM_POKE_BALL, ITEM_REPEL, ITEM_ESCAPE_ROPE, ITEM_ORAN_BERRY, ITEM_PECHA_BERRY, ITEM_CHERI_BERRY,
+        ITEM_CHESTO_BERRY, ITEM_RAWST_BERRY, ITEM_ASPEAR_BERRY, ITEM_PERSIM_BERRY, ITEM_TINY_MUSHROOM,
+    };
+    static const u16 sUncommon[] = {
+        ITEM_SUPER_POTION, ITEM_GREAT_BALL, ITEM_LEPPA_BERRY, ITEM_SITRUS_BERRY, ITEM_PEARL,
+        ITEM_STARDUST, ITEM_HEART_SCALE, ITEM_BIG_MUSHROOM, ITEM_SUPER_REPEL,
+    };
+    static const u16 sRare[] = {
+        ITEM_HYPER_POTION, ITEM_ULTRA_BALL, ITEM_REVIVE, ITEM_NUGGET, ITEM_STAR_PIECE,
+        ITEM_BIG_PEARL, ITEM_RARE_CANDY, ITEM_PP_UP,
+    };
+    int badges = 0, i;
+    u16 roll = Random() % 100;
+
+    for (i = FLAG_BADGE01_GET; i <= FLAG_BADGE08_GET; i++)
+        badges += FlagGet(i);
+    if (roll < 4 + badges)
+        return sRare[Random() % ARRAY_COUNT(sRare)];
+    if (roll < 25 + badges * 3)
+        return sUncommon[Random() % ARRAY_COUNT(sUncommon)];
+    return sCommon[Random() % ARRAY_COUNT(sCommon)];
+}
+
+static void SetTalkText(const u8 *text)
+{
+    StringExpandPlaceholders(gStringVar4, text);
+}
+
+// Special (waitstate): picks what the follower says (gStringVar4) and how
+// (VAR_RESULT, FOLLOWER_TALK_*), then shows its reaction.
+void FollowerInteract(void)
+{
+    struct ObjectEvent *obj = GetFollowerObject();
+    struct Pokemon *mon = GetFollowerMon();
+    const struct FollowerMessage *message;
+    u8 emotion;
+    u16 heldItem;
+
+    if (!obj || !mon)
+    {
+        gSpecialVar_Result = FOLLOWER_TALK_MESSAGE;
+        gStringVar4[0] = EOS;
+        ScriptContext_Enable();
+        return;
+    }
+
+    GetMonData(mon, MON_DATA_NICKNAME, gStringVar1);
+    StringGet_Nickname(gStringVar1);
+    heldItem = GetMonData(mon, MON_DATA_HELD_ITEM);
+    if (heldItem != ITEM_NONE)
+        CopyItemName(heldItem, gStringVar2);
+    sFollower.question = NULL;
+    sFollower.foundItem = ITEM_NONE;
+
+    // Now and then it has found something along the way.
+    if (sFollower.stepsSinceItem >= 200 && Random() % 5 == 0)
+    {
+        sFollower.stepsSinceItem = 0;
+        sFollower.foundItem = ChooseFoundItem();
+        CopyItemName(sFollower.foundItem, gStringVar2);
+        sFollower.talkKind = FOLLOWER_TALK_ITEM;
+        gSpecialVar_Result = FOLLOWER_TALK_ITEM;
+        SetTalkText(sFoundItemQuestions[Random() % ARRAY_COUNT(sFoundItemQuestions)]);
+        StartReaction(FOLLOWER_EMOTE_SURPRISE, FOLLOWER_MOTION_HOP, TRUE);
+        return;
+    }
+
+    emotion = ChooseEmotion(mon);
+
+    // Sometimes it asks for something.
+    if (emotion != FOLLOWER_EMOTE_POISONED && Random() % 8 == 0)
+    {
+        u8 matches[ARRAY_COUNT(sQuestions)], count = 0;
+        int i;
+        for (i = 0; i < (int)ARRAY_COUNT(sQuestions); i++)
+        {
+            if (sQuestions[i].askEmotions & (1 << emotion))
+                matches[count++] = i;
+        }
+        if (count)
+        {
+            sFollower.question = &sQuestions[matches[Random() % count]];
+            sFollower.talkKind = FOLLOWER_TALK_QUESTION;
+            gSpecialVar_Result = FOLLOWER_TALK_QUESTION;
+            SetTalkText(sFollower.question->question);
+            StartReaction(sFollower.question->emote, FOLLOWER_MOTION_NONE, TRUE);
+            return;
+        }
+    }
+
+    // Something about where it is or how it is (more often the more there is
+    // to say, up to half the time), otherwise a line for how it feels.
+    GatherConditionalMessages(mon, obj);
+    if (emotion != FOLLOWER_EMOTE_POISONED && sCandidateCount
+     && Random() % (sCandidateCount + 8) < min(sCandidateCount, 8))
+        message = &sCandidates[Random() % sCandidateCount];
+    else
+        message = &sMessagePools[emotion].messages[Random() % sMessagePools[emotion].count];
+
+    sFollower.talkKind = FOLLOWER_TALK_MESSAGE;
+    gSpecialVar_Result = FOLLOWER_TALK_MESSAGE;
+    SetTalkText(message->text);
+    StartReaction(message->emote, message->motion, TRUE);
+}
+
+// Special (waitstate), after a Yes/No: VAR_RESULT is the answer. For a found
+// item, leaves VAR_RESULT TRUE (and the item in VAR_0x8004) if it's to be
+// given.
+void FollowerAnswer(void)
+{
+    struct Pokemon *mon = GetFollowerMon();
+    bool8 yes = gSpecialVar_Result == 1; // YES
+
+    if (!mon || !GetFollowerObject())
+    {
+        gSpecialVar_Result = FALSE;
+        gStringVar4[0] = EOS;
+        ScriptContext_Enable();
+        return;
+    }
+
+    if (sFollower.talkKind == FOLLOWER_TALK_ITEM)
+    {
+        gSpecialVar_Result = FALSE;
+        if (!yes)
+        {
+            SetTalkText(sFoundItemKept);
+            StartReaction(FOLLOWER_EMOTE_HAPPY, FOLLOWER_MOTION_NONE, FALSE);
+        }
+        else if (!CheckBagHasSpace(sFollower.foundItem, 1))
+        {
+            SetTalkText(sFoundItemNoRoom);
+            StartReaction(FOLLOWER_EMOTE_ANGRY, FOLLOWER_MOTION_LOOK_AWAY, FALSE);
+        }
+        else
+        {
+            SetTalkText(sFoundItemTaken);
+            StartReaction(FOLLOWER_EMOTE_HAPPY, FOLLOWER_MOTION_HOP, FALSE);
+            gSpecialVar_0x8004 = sFollower.foundItem;
+            gSpecialVar_Result = TRUE;
+        }
+        return;
+    }
+
+    if (sFollower.question)
+    {
+        const struct FollowerQuestion *q = sFollower.question;
+        gSpecialVar_Result = FALSE;
+        if (yes)
+        {
+            AddMood(q->yesMood);
+            // Petting it and the like: a little friendship, at most once
+            // every so often.
+            if (q->yesFriendly && sFollower.stepsSinceFriendship >= 128)
+            {
+                u8 friendship = GetMonData(mon, MON_DATA_FRIENDSHIP);
+                sFollower.stepsSinceFriendship = 0;
+                if (friendship < MAX_FRIENDSHIP)
+                {
+                    friendship++;
+                    SetMonData(mon, MON_DATA_FRIENDSHIP, &friendship);
+                }
+            }
+            SetTalkText(q->yes);
+            StartReaction(q->yesEmote, q->yesEmote == FOLLOWER_EMOTE_MUSIC ? FOLLOWER_MOTION_HOP : FOLLOWER_MOTION_NONE, FALSE);
+        }
+        else
+        {
+            AddMood(q->noMood);
+            SetTalkText(q->no);
+            StartReaction(q->noEmote, FOLLOWER_MOTION_NONE, FALSE);
+        }
+        return;
+    }
+
+    gSpecialVar_Result = FALSE;
+    gStringVar4[0] = EOS;
+    ScriptContext_Enable();
+}
