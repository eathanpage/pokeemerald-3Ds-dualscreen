+#ifdef PLATFORM_3DS
+// The 3DS reads the pack from the SD card the first time it's wanted
+// (sdmc:/3ds/emerald3ds/followers.pack); without it there's no follower.
+// The switch is ENHANCEMENTS' FOLLOWING POKEMON (settings.txt
+// following_pokemon), and the extra palettes are the renderer's
+// (CtrVideo_SetExtObjPalette): set here, and fitted every frame to the fades
+// and weather tints the game puts on the sprite palettes, as the PC does.
+#include <stdio.h>
+
+// Not <stdlib.h>: global.h's abs() is a macro.
+void *malloc(size_t size);
+void free(void *ptr);
+
+FILE *CtrFs_OpenData(const char *relativePath, const char *mode);
+int CtrSettings_GetInt(const char *key, int fallback);
+void CtrLog_Write(int category, const char *format, ...);
+void CtrVideo_SetExtObjPalette(unsigned index, const u16 *colors);
+
+#define FOLLOWER_EXT_PALETTES 4
+
+static u8 *sFollowerPackData;
+static bool8 sFollowerPackTried;
+static const void *sExtImages[FOLLOWER_EXT_PALETTES];
+static u16 sExtColors[FOLLOWER_EXT_PALETTES][16];
+#define gFollowerPack ((const u8 *)sFollowerPackData)
+
+static bool8 LoadFollowerPack(void)
+{
+    FILE *file;
+    long size;
+
+    if (sFollowerPackData || sFollowerPackTried)
+        return sFollowerPackData != NULL;
+    sFollowerPackTried = TRUE;
+    file = CtrFs_OpenData("followers.pack", "rb");
+    if (!file)
+    {
+        CtrLog_Write(6, "followers: no followers.pack on the SD card");
+        return FALSE;
+    }
+    fseek(file, 0, SEEK_END);
+    size = ftell(file);
+    fseek(file, 0, SEEK_SET);
+    if (size > 16 && (sFollowerPackData = malloc(size)) != NULL
+     && fread(sFollowerPackData, 1, size, file) != (size_t)size)
+    {
+        free(sFollowerPackData);
+        sFollowerPackData = NULL;
+    }
+    fclose(file);
+    CtrLog_Write(5, "followers: pack %s (%ld bytes)", sFollowerPackData ? "loaded" : "not loaded", size);
+    return sFollowerPackData != NULL;
+}
+
+bool8 PlatformFollowingPokemonEnabled(void)
+{
+    return CtrSettings_GetInt("following_pokemon", 1) && LoadFollowerPack();
+}
+
+void PlatformSetExtObjPalette(u8 index, const void *images, const u16 *colors)
+{
+    if (index >= FOLLOWER_EXT_PALETTES)
+        return;
+    sExtImages[index] = images;
+    if (colors)
+        memcpy(sExtColors[index], colors, sizeof(sExtColors[index]));
+}
+
+u8 PlatformGetExtObjPalette(const void *images)
+{
+    int i;
+
+    if (!images)
+        return 0;
+    for (i = 0; i < FOLLOWER_EXT_PALETTES; i++)
+    {
+        if (sExtImages[i] == images)
+            return i + 1;
+    }
+    return 0;
+}
+
+// What the game is doing to the sprite palettes this frame (fades, weather
+// tints), fitted per channel as a*x+b from the player's and the NPCs'
+// palettes, applied to the extra ones (the PC's ppu.c, UpdateExtObjPalettes).
+static void UpdateExtObjPalettes(void)
+{
+    static const u8 slots[] = {0, 2, 3, 4, 5};
+    const u16 *unfaded = gPlttBufferUnfaded + 256;
+    const u16 *shown = gPlttBufferFaded + 256;
+    float a[3], b[3];
+    bool32 identity = TRUE;
+    int c, i, k, n = 0;
+
+    for (i = 0; i < (int)ARRAY_COUNT(slots); i++)
+    {
+        if (memcmp(&unfaded[slots[i] * 16], &shown[slots[i] * 16], 32))
+            identity = FALSE;
+    }
+    if (!identity)
+    {
+        for (c = 0; c < 3; c++)
+        {
+            float mx = 0, my = 0, sxx = 0, sxy = 0;
+            n = 0;
+            for (i = 0; i < (int)ARRAY_COUNT(slots); i++)
+            {
+                for (k = 1; k < 16; k++)
+                {
+                    mx += (unfaded[slots[i] * 16 + k] >> (c * 5)) & 31;
+                    my += (shown[slots[i] * 16 + k] >> (c * 5)) & 31;
+                    n++;
+                }
+            }
+            mx /= n;
+            my /= n;
+            for (i = 0; i < (int)ARRAY_COUNT(slots); i++)
+            {
+                for (k = 1; k < 16; k++)
+                {
+                    float x = (float)((unfaded[slots[i] * 16 + k] >> (c * 5)) & 31) - mx;
+                    float y = (float)((shown[slots[i] * 16 + k] >> (c * 5)) & 31) - my;
+                    sxx += x * x;
+                    sxy += x * y;
+                }
+            }
+            a[c] = sxx > 0 ? sxy / sxx : 1;
+            b[c] = my - a[c] * mx;
+        }
+    }
+    for (k = 0; k < FOLLOWER_EXT_PALETTES; k++)
+    {
+        u16 out[16];
+
+        if (!sExtImages[k])
+            continue;
+        if (identity)
+        {
+            CtrVideo_SetExtObjPalette(k, sExtColors[k]);
+            continue;
+        }
+        for (i = 0; i < 16; i++)
+        {
+            u16 color = 0;
+            for (c = 0; c < 3; c++)
+            {
+                int v = (int)(a[c] * ((sExtColors[k][i] >> (c * 5)) & 31) + b[c] + 0.5f);
+                if (v < 0) v = 0;
+                if (v > 31) v = 31;
+                color |= v << (c * 5);
+            }
+            out[i] = color;
+        }
+        CtrVideo_SetExtObjPalette(k, out);
+    }
+}
