+// ---------------------------------------------------------------------------
+// Sprite pack (see tools/followers/followers.py)
+
+struct FollowerPackEntry
+{
+    u16 species;
+    u8 form;
+    u8 female;
+    u8 size;   // frames are size x size
+    u8 frames; // 6: down, up, left (right mirrored); 8: right too
+    u16 padding;
+    u32 palettes; // 16 normal + 16 shiny colours
+    u32 tiles;
+};
+
+#define PACK_ENTRIES ((const struct FollowerPackEntry *)(gFollowerPack + 16))
+#define NUM_EMOTE_FRAMES 23
+#define EMOTE_FRAME_SIZE (16 * 16 / 2)
+
+static u32 PackWord(u32 offset)
+{
+    u32 value;
+    memcpy(&value, gFollowerPack + offset, sizeof(value));
+    return value;
+}
+
+static const struct FollowerPackEntry *FindPackEntry(u16 species, u8 form, bool8 female)
+{
+    const struct FollowerPackEntry *best = NULL;
+    u32 i, count = PackWord(8);
+
+    for (i = 0; i < count; i++)
+    {
+        const struct FollowerPackEntry *e = &PACK_ENTRIES[i];
+        if (e->species != species)
+            continue;
+        if (e->form == form && e->female == female)
+            return e;
+        if (!best || (e->form == form && best->form != form) || (e->form == 0 && !e->female && best->form != form))
+            best = e;
+    }
+    return best;
+}
