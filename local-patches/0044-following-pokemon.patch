+// ---------------------------------------------------------------------------
+// Which Pokemon follows, and where
+
+// The tallest Pokemon (tp_param's too_tall) stay outside buildings.
+static bool8 IsTooTall(u16 species)
+{
+    switch (species)
+    {
+    case SPECIES_STEELIX:
+    case SPECIES_LUGIA:
+    case SPECIES_HO_OH:
+    case SPECIES_WAILORD:
+    case SPECIES_KYOGRE:
+    case SPECIES_GROUDON:
+    case SPECIES_RAYQUAZA:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static u16 CurrentMapId(void)
+{
+    return gSaveBlock1Ptr->location.mapNum | (gSaveBlock1Ptr->location.mapGroup << 8);
+}
+
+// HGSS gives every map a follow mode: none allowed, not the tallest ones, or
+// all. Emerald's maps get theirs here: none where the game takes over the
+// party or the player (link rooms, battle facilities, the Safari Zone, as in
+// HGSS), height-restricted indoors.
+static bool8 IsAllowedHere(u16 species)
+{
+    u8 mapType = gMapHeader.mapType;
+    u16 mapSec = gMapHeader.regionMapSectionId;
+
+    if (InUnionRoom() || InTrainerHill() || CurrentBattlePyramidLocation() != PYRAMID_LOCATION_NONE
+     || GetSafariZoneFlag() || mapSec == MAPSEC_SAFARI_ZONE)
+        return FALSE;
+    switch (CurrentMapId())
+    {
+    case MAP_TRADE_CENTER:
+    case MAP_RECORD_CORNER:
+    case MAP_BATTLE_COLOSSEUM_2P:
+    case MAP_BATTLE_COLOSSEUM_4P:
+    case MAP_UNION_ROOM:
+        return FALSE;
+    }
+    if (mapSec == MAPSEC_BATTLE_FRONTIER && mapType == MAP_TYPE_INDOOR)
+        return FALSE;
+    if (mapType == MAP_TYPE_UNDERWATER)
+        return FALSE;
+    if ((mapType == MAP_TYPE_INDOOR || mapType == MAP_TYPE_SECRET_BASE) && IsTooTall(species))
+        return FALSE;
+    return TRUE;
+}
+
+static bool8 IsEggOrEmpty(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES_OR_EGG);
+    return species == SPECIES_NONE || species == SPECIES_EGG;
+}
+
+// The first Pokemon that can battle, or the first that isn't an Egg.
+static struct Pokemon *GetFollowerMon(void)
+{
+    int i;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (!IsEggOrEmpty(&gPlayerParty[i]) && GetMonData(&gPlayerParty[i], MON_DATA_HP) != 0)
+            return &gPlayerParty[i];
+    }
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (!IsEggOrEmpty(&gPlayerParty[i]))
+            return &gPlayerParty[i];
+    }
+    return NULL;
+}
