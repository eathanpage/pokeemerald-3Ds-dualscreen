+// ---------------------------------------------------------------------------
+// Mood (HGSS's FieldSystem_UnkSub108_*)
+
+static bool8 IsMoodMon(struct Pokemon *mon)
+{
+    return sFollower.moodRegistered && GetMonData(mon, MON_DATA_SPECIES) == sFollower.moodSpecies
+        && GetMonData(mon, MON_DATA_PERSONALITY) == sFollower.moodPersonality;
+}
+
+// A different Pokemon following starts from a neutral mood.
+static void RegisterMoodMon(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u32 personality = GetMonData(mon, MON_DATA_PERSONALITY);
+    if (species != SPECIES_NONE && (!sFollower.moodRegistered || sFollower.moodSpecies != species
+                                    || sFollower.moodPersonality != personality))
+    {
+        sFollower.moodRegistered = TRUE;
+        sFollower.moodSpecies = species;
+        sFollower.moodPersonality = personality;
+        sFollower.mood = 0;
+    }
+}
+
+static void AddMood(s32 by)
+{
+    s32 mood = sFollower.mood + by;
+    if (mood > 127)
+        mood = 127;
+    else if (mood < -127)
+        mood = -127;
+    sFollower.mood = mood;
+}
+
+// pokemon_mood.c's sMoodModifiers, by what Emerald calls the events.
+void Follower_OnFriendshipEvent(struct Pokemon *mon, u8 event)
+{
+    if (!IsMoodMon(mon))
+        return;
+    switch (event)
+    {
+    case FRIENDSHIP_EVENT_GROW_LEVEL: // MON_MOOD_MODIFIER_LEVEL_UP_IN_BATTLE
+    case FRIENDSHIP_EVENT_LEARN_TMHM:
+        AddMood(40);
+        break;
+    case FRIENDSHIP_EVENT_FAINT_SMALL:
+        AddMood(-80);
+        break;
+    case FRIENDSHIP_EVENT_FAINT_LARGE: // fainted against a foe 30+ levels higher
+        AddMood(-100);
+        break;
+    case FRIENDSHIP_EVENT_FAINT_FIELD_PSN: // MON_MOOD_MODIFIER_SURVIVED_PSN
+        AddMood(-50);
+        break;
+    }
+}
+
+// pokemon_mood.c's ItemIdGetMoodEffect.
+void Follower_OnItemUsed(struct Pokemon *mon, u16 item)
+{
+    if (!IsMoodMon(mon))
+        return;
+    switch (item)
+    {
+    case ITEM_RARE_CANDY:
+        AddMood(40);
+        break;
+    case ITEM_ENERGY_POWDER:
+    case ITEM_HEAL_POWDER:
+        AddMood(-20);
+        break;
+    case ITEM_ENERGY_ROOT:
+        AddMood(-30);
+        break;
+    case ITEM_REVIVAL_HERB:
+        AddMood(-40);
+        break;
+    case ITEM_HP_UP:
+    case ITEM_PROTEIN:
+    case ITEM_IRON:
+    case ITEM_CARBOS:
+    case ITEM_CALCIUM:
+    case ITEM_ZINC:
+        AddMood(8);
+        break;
+    case ITEM_GUARD_SPEC:
+    case ITEM_DIRE_HIT:
+    case ITEM_X_ATTACK:
+    case ITEM_X_DEFEND:
+    case ITEM_X_SPEED:
+    case ITEM_X_ACCURACY:
+    case ITEM_X_SPECIAL:
+        AddMood(10);
+        break;
+    }
+}
+
+void Follower_OnPlayerStepTaken(void)
+{
+    if (sFollower.stepsSinceItem < 0xFFFF)
+        sFollower.stepsSinceItem++;
+    if (sFollower.stepsSinceFriendship < 0xFFFF)
+        sFollower.stepsSinceFriendship++;
+    // FieldSystem_UnkSub108_MoveMoodTowardsNeutral, while it's out.
+    if (GetFollowerObject())
+    {
+        if (sFollower.mood < 0)
+            sFollower.mood++;
+        else if (sFollower.mood > 0)
+            sFollower.mood--;
+    }
+}
