+static void BuildGraphics(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 form = species == SPECIES_UNOWN ? GET_UNOWN_LETTER(GetMonData(mon, MON_DATA_PERSONALITY)) : 0;
+    bool8 female = GetMonGender(mon) == MON_FEMALE;
+    bool8 shiny = IsMonShiny(mon);
+    const struct FollowerPackEntry *e = FindPackEntry(species, form, female);
+    u32 frameSize, i;
+
+    if (!e)
+        e = FindPackEntry(SPECIES_BULBASAUR, 0, FALSE);
+    frameSize = e->size * e->size / 2;
+    for (i = 0; i < ARRAY_COUNT(sFrameImages); i++)
+    {
+        u32 frame = i < e->frames ? i : i - 2; // right: the left frames, mirrored
+        sFrameImages[i].data = gFollowerPack + e->tiles + frame * frameSize;
+        sFrameImages[i].size = frameSize;
+    }
+    memcpy(sPalette, gFollowerPack + e->palettes + (shiny ? 32 : 0), sizeof(sPalette));
+    InitFollowerGraphicsInfo(&sGraphicsInfo, e->size, e->frames == 8 ? sAnimTable_OwnEast : sAnimTable_Mirrored,
+                             sFrameImages);
+    PlatformSetExtObjPalette(EXT_PALETTE_FOLLOWER, sFrameImages, sPalette);
+
+    sFollower.haveGraphics = TRUE;
+    sFollower.species = species;
+    sFollower.form = form;
+    sFollower.female = female;
+    sFollower.shiny = shiny;
+}
+
+// Returns TRUE if the graphics changed.
+static bool8 UpdateGraphics(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 form = species == SPECIES_UNOWN ? GET_UNOWN_LETTER(GetMonData(mon, MON_DATA_PERSONALITY)) : 0;
+
+    RegisterMoodMon(mon);
+    if (sFollower.haveGraphics && sFollower.species == species && sFollower.form == form
+     && sFollower.female == (GetMonGender(mon) == MON_FEMALE) && sFollower.shiny == IsMonShiny(mon))
+        return FALSE;
+    BuildGraphics(mon);
+    return TRUE;
+}
