+// ---------------------------------------------------------------------------
+// Talking to it: the emote bubble
+
+#define sTimer data[0]
+#define sObjId data[1]
+
+static void SpriteCB_Emote(struct Sprite *sprite)
+{
+    struct ObjectEvent *obj = &gObjectEvents[sprite->sObjId];
+    struct Sprite *mon = &gSprites[obj->spriteId];
+
+    if (!Follower_IsFollower(obj) || ++sprite->sTimer > 64)
+    {
+        sFollower.emoteSpriteId = MAX_SPRITES;
+        DestroySprite(sprite);
+        return;
+    }
+    sprite->x = mon->x;
+    sprite->y = mon->y + mon->centerToCornerVecY + 4;
+    sprite->x2 = mon->x2;
+    sprite->y2 = mon->y2 + (sprite->sTimer < 4 ? 4 - sprite->sTimer : 0); // pops up
+}
+
+static const struct OamData sOam_Emote = {
+    .shape = SPRITE_SHAPE(16x16),
+    .size = SPRITE_SIZE(16x16),
+    .priority = 1,
+};
+
+static const union AnimCmd sAnim_Emote[] = {
+    ANIMCMD_FRAME(0, 12),
+    ANIMCMD_FRAME(1, 12),
+    ANIMCMD_JUMP(0),
+};
+
+static const union AnimCmd *const sAnims_Emote[] = {sAnim_Emote};
+
+static const struct SpriteTemplate sSpriteTemplate_Emote = {
+    .tileTag = TAG_NONE,
+    .paletteTag = TAG_NONE,
+    .oam = &sOam_Emote,
+    .anims = sAnims_Emote,
+    .images = sEmoteImages,
+    .affineAnims = gDummySpriteAffineAnimTable,
+    .callback = SpriteCB_Emote,
+};
+
+static void ShowEmote(struct ObjectEvent *obj, u8 emote)
+{
+    u32 emotes = PackWord(12);
+    u8 spriteId;
+    int i;
+
+    if (sFollower.emoteSpriteId < MAX_SPRITES)
+    {
+        DestroySprite(&gSprites[sFollower.emoteSpriteId]);
+        sFollower.emoteSpriteId = MAX_SPRITES;
+    }
+    for (i = 0; i < 2; i++)
+    {
+        u32 frame = emote * 2 + i;
+        if (frame >= NUM_EMOTE_FRAMES)
+            frame = NUM_EMOTE_FRAMES - 1;
+        sEmoteImages[i].data = gFollowerPack + emotes + 32 + frame * EMOTE_FRAME_SIZE;
+        sEmoteImages[i].size = EMOTE_FRAME_SIZE;
+    }
+    memcpy(sEmotePalette, gFollowerPack + emotes, sizeof(sEmotePalette));
+    PlatformSetExtObjPalette(EXT_PALETTE_EMOTE, sEmoteImages, sEmotePalette);
+
+    spriteId = CreateSprite(&sSpriteTemplate_Emote, 0, 0, 0);
+    if (spriteId == MAX_SPRITES)
+        return;
+    gSprites[spriteId].coordOffsetEnabled = TRUE;
+    gSprites[spriteId].oam.paletteNum = 0;
+    gSprites[spriteId].sObjId = obj - gObjectEvents;
+    gSprites[spriteId].sTimer = 0;
+    SpriteCB_Emote(&gSprites[spriteId]);
+    sFollower.emoteSpriteId = spriteId;
+}
