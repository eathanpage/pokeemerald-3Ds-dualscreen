diff --git a/include/online_link.h b/include/online_link.h
new file mode 100644
index 0000000..dd503b6
--- /dev/null
+++ b/include/online_link.h
@@ -0,0 +1,26 @@
+#ifndef GUARD_ONLINE_LINK_H
+#define GUARD_ONLINE_LINK_H
+
+// Online play: the link through the emulated Wireless Adapter
+// (3ds_port/src/3ds_rfu_adapter.c), connected to other players by the relay
+// server (3ds_port/src/3ds_online.c).
+
+// While linked through the online relay, battle messages go whole, straight
+// to the other players (everyone gets their own back too, in order).
+bool8 PlatformOnlineEnabled(void);    // online play is set up (a server in the settings)
+bool8 PlatformOnlineLinkActive(void);
+void PlatformOnlineBattleReset(void);
+void PlatformOnlineBattleSend(const void *data, u16 size, bool8 toSelf);
+u16 PlatformOnlineBattleRecv(void *out, u16 max); // next message, 0 if none
+// Link blocks (SendBlock) the same way: the next block from the player with
+// that index in the link layer (0 if none). The host works out the index of
+// a child's blocks with PlatformRfuPlayerIndexForSlot (link_rfu_2.c).
+void PlatformOnlineBlockSend(const void *data, u16 size);
+u16 PlatformOnlineBlockTake(u8 playerIndex, void *out, u16 max);
+u8 PlatformRfuPlayerIndexForSlot(u8 slot);
+
+// The Pokemon Center attendants' online room menu (src/online_room.c): once a
+// frame, leaves the room when the player has walked away from the counter.
+void OnlineRoom_Update(void);
+
+#endif // GUARD_ONLINE_LINK_H
