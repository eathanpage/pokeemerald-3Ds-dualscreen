+@ Online play: which online room to meet other players in. Players
+@ in the same room find each other through the wireless features as if they
+@ were next to each other. See src/online_room.c.
+@ VAR_0x800A: the counter (ONLINE_KIND_*), whose rooms are the only ones
+@ made or joined here. VAR_0x8009 is TRUE afterwards if the player made or
+@ joined a room.
+CableClub_EventScript_OnlineRoom::
+	setvar VAR_0x8009, FALSE
+	specialvar VAR_RESULT, OnlineRoom_IsEnabled
+	goto_if_eq VAR_RESULT, FALSE, CableClub_EventScript_OnlineRoomEnd
+CableClub_EventScript_OnlineRoomMenu::
+	specialvar VAR_RESULT, OnlineRoom_BufferCode
+	goto_if_eq VAR_RESULT, ONLINE_ROOM_IN, CableClub_EventScript_OnlineInRoomMenu
+	message CableClub_Text_OnlineNoRoom
+	waitmessage
+	multichoice 18, 6, MULTI_ONLINE_NO_ROOM, FALSE
+	switch VAR_RESULT
+	case 0, CableClub_EventScript_OnlineNewRoom
+	case 1, CableClub_EventScript_OnlineJoinRoom
+	goto CableClub_EventScript_AbortLink @ No thanks / B: that's all
+CableClub_EventScript_OnlineRoomEnd::
+	return
+
+CableClub_EventScript_OnlineInRoomMenu::
+	message CableClub_Text_OnlineRoom
+	waitmessage
+	multichoice 16, 4, MULTI_ONLINE_ROOM, FALSE
+	switch VAR_RESULT
+	case 1, CableClub_EventScript_OnlineJoinRoom
+	case 2, CableClub_EventScript_OnlineNewRoom
+	case 3, CableClub_EventScript_OnlineLeaveRoom
+	return
+
+CableClub_EventScript_OnlineLeaveRoom::
+	special OnlineRoom_Leave
+	msgbox CableClub_Text_OnlineLeftRoom, MSGBOX_DEFAULT
+	goto CableClub_EventScript_AbortLink
+
+CableClub_EventScript_OnlineJoinRoom::
+	special OnlineRoom_EnterCode
+	waitstate
+	specialvar VAR_RESULT, OnlineRoom_JoinEnteredCode
+	goto_if_eq VAR_RESULT, 0, CableClub_EventScript_OnlineRoomMenu
+	goto_if_eq VAR_RESULT, 2, CableClub_EventScript_OnlineInvalidCode
+	message CableClub_Text_OnlineConnecting
+	waitmessage
+	special OnlineRoom_Wait
+	waitstate
+	goto_if_eq VAR_RESULT, ONLINE_ROOM_IN, CableClub_EventScript_OnlineJoinedRoom
+	goto CableClub_EventScript_OnlineRoomFailed
+
+CableClub_EventScript_OnlineJoinedRoom::
+	setvar VAR_0x8009, TRUE
+	return
+
+CableClub_EventScript_OnlineInvalidCode::
+	msgbox CableClub_Text_OnlineInvalidCode, MSGBOX_DEFAULT
+	goto CableClub_EventScript_OnlineRoomMenu
+
+CableClub_EventScript_OnlineNewRoom::
+	special OnlineRoom_New
+	message CableClub_Text_OnlineConnecting
+	waitmessage
+	special OnlineRoom_Wait
+	waitstate
+CableClub_EventScript_OnlineRoomFailed::
+	switch VAR_RESULT
+	case ONLINE_ROOM_IN, CableClub_EventScript_OnlineInRoom
+	case ONLINE_ROOM_NOT_FOUND, CableClub_EventScript_OnlineRoomNotFound
+	case ONLINE_ROOM_BAD_CODE, CableClub_EventScript_OnlineRoomNotFound
+	case ONLINE_ROOM_FULL, CableClub_EventScript_OnlineRoomFull
+	case ONLINE_ROOM_OLD_VERSION, CableClub_EventScript_OnlineOldVersion
+	case ONLINE_ROOM_OTHER_VERSION, CableClub_EventScript_OnlineOtherVersion
+	case ONLINE_ROOM_WRONG_KIND, CableClub_EventScript_OnlineWrongKind
+	msgbox CableClub_Text_OnlineNoServer, MSGBOX_DEFAULT
+	goto CableClub_EventScript_OnlineRoomMenu
+
+CableClub_EventScript_OnlineInRoom::
+	msgbox CableClub_Text_OnlineInRoom, MSGBOX_DEFAULT
+	setvar VAR_0x8009, TRUE
+	return
+
+CableClub_EventScript_OnlineRoomNotFound::
+	msgbox CableClub_Text_OnlineRoomNotFound, MSGBOX_DEFAULT
+	goto CableClub_EventScript_OnlineRoomMenu
+
+CableClub_EventScript_OnlineRoomFull::
+	msgbox CableClub_Text_OnlineRoomFull, MSGBOX_DEFAULT
+	goto CableClub_EventScript_OnlineRoomMenu
+
+CableClub_EventScript_OnlineWrongKind::
+	msgbox CableClub_Text_OnlineWrongKind, MSGBOX_DEFAULT
