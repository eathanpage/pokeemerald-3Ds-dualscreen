new file mode 100644
index 0000000..90ae0be
--- /dev/null
+++ b/include/constants/online.h
@@ -0,0 +1,27 @@
+#ifndef GUARD_CONSTANTS_ONLINE_H
+#define GUARD_CONSTANTS_ONLINE_H
+
+// Online play (3ds_port/src/3ds_online.c): the state of joining a room, as the
+// Pokémon Center attendants' scripts see it (special Online_WaitForRoom).
+#define ONLINE_ROOM_OFF          0 // online play isn't set up (no server in the settings)
+#define ONLINE_ROOM_CONNECTING   1
+#define ONLINE_ROOM_IN           2
+#define ONLINE_ROOM_NO_SERVER    3 // can't reach the server (still trying)
+#define ONLINE_ROOM_NOT_FOUND    4 // nobody's in a room with that code
+#define ONLINE_ROOM_BAD_CODE     5
+#define ONLINE_ROOM_FULL         6
+#define ONLINE_ROOM_OLD_VERSION  7 // the server wants a newer game
+#define ONLINE_ROOM_NONE         8 // not in a room (until the player makes or joins one)
+#define ONLINE_ROOM_WRONG_KIND   9 // the code is for the other counter's rooms
+#define ONLINE_ROOM_OTHER_VERSION 10 // the players in it have another version of the game
+
+// Which counter a room is for: a code only works at the counter it was made at.
+#define ONLINE_KIND_ANY            0 // rooms given at startup (tests)
+#define ONLINE_KIND_UNION_ROOM     1
+#define ONLINE_KIND_DIRECT_CORNER  2
+#define ONLINE_KIND_GAME_CORNER    3 // Mossdeep Game Corner: Pokemon Jump, Dodrio Berry-Picking
+#define ONLINE_KIND_BERRY_BLENDER  4 // Lilycove Contest Hall's Berry Blenders
+#define ONLINE_KIND_CONTEST        5 // Lilycove Contest Hall's link contest receptionist
+#define ONLINE_KIND_BATTLE_TOWER   6 // Battle Tower link multi battles
+
+#endif // GUARD_CONSTANTS_ONLINE_H
