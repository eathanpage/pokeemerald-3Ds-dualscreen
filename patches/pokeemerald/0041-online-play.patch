+static const u8 sText_NoRoom[] = _("none");
+static const u8 sText_UnionRoom[] = _("UNION ROOM");
+static const u8 sText_DirectCorner[] = _("DIRECT CORNER");
+static const u8 sText_GameCorner[] = _("GAME CORNER");
+static const u8 sText_BerryBlender[] = _("BERRY BLENDER");
+static const u8 sText_Contest[] = _("CONTEST HALL");
+static const u8 sText_BattleTower[] = _("BATTLE TOWER");
+
+// Room codes are upper-case letters and digits (ASCII); the game has its
+// own character set.
+static void CodeToText(u8 *dest, const char *code)
+{
+    for (; *code; code++)
+    {
+        if (*code >= 'A' && *code <= 'Z')
+            *dest++ = CHAR_A + (*code - 'A');
+        else if (*code >= '0' && *code <= '9')
+            *dest++ = CHAR_0 + (*code - '0');
+    }
+    *dest = EOS;
+}
+
+static void TextToCode(char *code, const u8 *src)
+{
+    int n = 0;
+    for (; *src != EOS && n < 8; src++)
+    {
+        if (*src >= CHAR_A && *src <= CHAR_Z)
+            code[n++] = 'A' + (*src - CHAR_A);
+        else if (*src >= CHAR_a && *src <= CHAR_z)
+            code[n++] = 'A' + (*src - CHAR_a);
+        else if (*src >= CHAR_0 && *src <= CHAR_0 + 9)
+            code[n++] = '0' + (*src - CHAR_0);
+    }
+    code[n] = '\0';
+}
+
+u16 OnlineRoom_IsEnabled(void)
+{
+    char code[16];
+    return Online_GetRoom(code, sizeof(code)) != ONLINE_ROOM_OFF;
+}
+
+// The counter the script is at (VAR_0x800A, ONLINE_KIND_*): its rooms are
+// the only ones it makes or joins.
+static u8 CounterKind(void)
+{
+    return gSpecialVar_0x800A;
+}
+
+// gStringVar1: the room's code ("none" if not in one). Returns ONLINE_ROOM_*;
+// a room of the other counter's kind counts as none.
+u16 OnlineRoom_BufferCode(void)
+{
+    char code[16];
+    u8 state = Online_GetRoom(code, sizeof(code));
+    u8 kind = Online_GetRoomKind();
+    if (state == ONLINE_ROOM_IN && kind != ONLINE_KIND_ANY && kind != CounterKind())
+        state = ONLINE_ROOM_NONE;
+    if (state == ONLINE_ROOM_IN)
+        CodeToText(gStringVar1, code);
+    else
+        StringCopy(gStringVar1, sText_NoRoom);
+    return state;
+}
+
+// The naming screen's keyboard, for typing a code into gStringVar2.
+void OnlineRoom_EnterCode(void)
+{
+    gStringVar2[0] = EOS;
+    DoNamingScreen(NAMING_SCREEN_ROOM_CODE, gStringVar2, 0, 0, 0, CB2_ReturnToFieldContinueScript);
+}
+
+// Codes are made by the server: 6 of these (no 0/O, 1/I/L).
+static bool8 IsValidCode(const char *code)
+{
+    static const char sAlphabet[] = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
+    int n;
+    for (n = 0; code[n]; n++)
+        if (!strchr(sAlphabet, code[n]))
+            return FALSE;
+    return n == 6;
+}
+
+// Joins the room typed in (only if it exists). Returns 0 if nothing was
+// typed, 1 if joining, 2 if it can't be a room code.
+u16 OnlineRoom_JoinEnteredCode(void)
+{
+    char code[16];
+    TextToCode(code, gStringVar2);
+    if (code[0] == '\0')
+        return 0;
+    if (!IsValidCode(code))
+        return 2;
+    Online_JoinRoom(code, ONLINE_JOIN_ONLY, CounterKind());
+    return 1;
+}
+
+void OnlineRoom_New(void)
+{
+    Online_JoinRoom(NULL, ONLINE_JOIN_OR_CREATE, CounterKind());
+}
+
+// Whether the attendant lets the player in: with online play set up, only
+// while in an online room for this counter (without it, the missing
+// Wireless Adapter keeps them out as before).
+u16 OnlineRoom_CanEnter(void)
+{
+    char code[16];
+    u8 state = Online_GetRoom(code, sizeof(code));
+    u8 kind = Online_GetRoomKind();
+
+    if (state == ONLINE_ROOM_OFF)
+        return TRUE;
+    return state == ONLINE_ROOM_IN && (kind == ONLINE_KIND_ANY || kind == CounterKind());
+}
+
+void OnlineRoom_Leave(void)
+{
+    Online_LeaveRoom();
+}
+
+#define tFrames data[0]
+
+static void Task_WaitForRoom(u8 taskId)
+{
+    char code[16];
+    u8 state = Online_GetRoom(code, sizeof(code));
+
+    if (state == ONLINE_ROOM_CONNECTING && ++gTasks[taskId].tFrames < WAIT_FRAMES)
+        return;
+    if (state == ONLINE_ROOM_IN)
+        CodeToText(gStringVar1, code);
+    if (state == ONLINE_ROOM_WRONG_KIND)
+    {
+        switch (Online_GetRoomKind())
+        {
+        case ONLINE_KIND_UNION_ROOM:
+            StringCopy(gStringVar2, sText_UnionRoom);
+            break;
+        case ONLINE_KIND_GAME_CORNER:
+            StringCopy(gStringVar2, sText_GameCorner);
+            break;
+        case ONLINE_KIND_BERRY_BLENDER:
+            StringCopy(gStringVar2, sText_BerryBlender);
+            break;
+        case ONLINE_KIND_CONTEST:
+            StringCopy(gStringVar2, sText_Contest);
+            break;
+        case ONLINE_KIND_BATTLE_TOWER:
+            StringCopy(gStringVar2, sText_BattleTower);
+            break;
+        default:
+            StringCopy(gStringVar2, sText_DirectCorner);
+            break;
+        }
+    }
+    gSpecialVar_Result = state;
+    DestroyTask(taskId);
+    ScriptContext_Enable();
+}
+
+// Waits until the server lets us in (or doesn't); VAR_RESULT: ONLINE_ROOM_*,
+// gStringVar1: the code.
+void OnlineRoom_Wait(void)
+{
+    CreateTask(Task_WaitForRoom, 80);
+}
+
+#undef tFrames
+
+static bool8 InLinkRoom(void)
+{
+    static const u16 sLinkRooms[] = {
+        MAP_UNION_ROOM, MAP_TRADE_CENTER, MAP_RECORD_CORNER,
+        MAP_BATTLE_COLOSSEUM_2P, MAP_BATTLE_COLOSSEUM_4P,
+    };
+    u32 i;
+    for (i = 0; i < ARRAY_COUNT(sLinkRooms); i++)
+        if (gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(sLinkRooms[i])
+         && gSaveBlock1Ptr->location.mapNum == MAP_NUM(sLinkRooms[i]))
+            return TRUE;
+    return FALSE;
+}
+
+// Once a frame (from the port's frame loop): the room is only for meeting
+// people through the attendant you made or joined it with, so once the
+// player is walking around outside the link rooms again (left the Union
+// Room or Trade Center, or didn't go in after all), leave it.
+void OnlineRoom_Update(void)
+{
+    static u16 sFreeFrames;
+    char code[16];
+    u8 state = Online_GetRoom(code, sizeof(code));
+
+    if (state == ONLINE_ROOM_OFF || state == ONLINE_ROOM_NONE || Online_IsRoomFixed())
+    {
+        sFreeFrames = 0;
+        return;
+    }
+    if (gMain.callback2 == CB2_Overworld && !ArePlayerFieldControlsLocked()
+     && !ScriptContext_IsEnabled() && !InLinkRoom())
+    {
+        if (++sFreeFrames >= LEAVE_FRAMES)
+        {
+            sFreeFrames = 0;
+            Online_LeaveRoom();
+        }
+    }
+    else
+    {
+        sFreeFrames = 0;
+    }
+}
+
+#endif // PLATFORM_3DS
